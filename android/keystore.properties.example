# Local Android Keystore Configuration
# Copy this file to 'android/keystore.properties' or project root 'keystore.properties'
# and replace with your real keystore passwords.
# NOTE: keystore.properties is in .gitignore and will never be committed.

storeFile=../blitzcount-release.keystore
storePassword=your_keystore_password
keyAlias=blitzcount
keyPassword=your_key_password
